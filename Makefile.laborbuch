# Einbinden in das Haupt-Makefile mit:  include Makefile.laborbuch
LB := python3 tools/lb.py

.PHONY: laborbuch laborbuch-html laborbuch-pruefen laborbuch-schuetzen laborbuch-preflight laborbuch-ereignisse

laborbuch:            ## Gesamt-PDF: laborbuch/_buch/
	$(LB) buch --format pdf

laborbuch-html:       ## Gesamt-HTML (durchsuchbar)
	$(LB) buch --format html

laborbuch-pruefen:    ## vollständige Prüfung aller Dokumente
	$(LB) pruefe --alle

laborbuch-schuetzen:  ## Schutz-Manifest neu schreiben (nur Mensch, danach committen)
	$(LB) schuetze

laborbuch-preflight:  ## Bereitschaft für unbeaufsichtigte Sessions
	$(LB) preflight

laborbuch-ereignisse:
	$(LB) ereignisse --offen
